{
  "name": "rosetta",
  "version": "1.0.0",
  "private": true,
  "description": "Rosetta — a quiet library and reader for EPUB, PDF, Word, Markdown and plain-text documents.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && node scripts/check-colours.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "check": "node design/build-tokens.mjs --check && npm run lint && npm run typecheck && npm test",
    "tokens": "node design/build-tokens.mjs --css src/styles/tokens.css --fonts src/styles/fonts",
    "icons": "node scripts/build-icons.mjs",
    "assets": "node scripts/build-app-icons.mjs",
    "sync": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "android": "npm run sync && cap open android",
    "android:run": "npm run sync && cap run android",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "ios": "npm run sync:ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lucide-static": "1.68.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
