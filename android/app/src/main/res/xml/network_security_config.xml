<?xml version="1.0" encoding="utf-8"?>
<!--
  Catalogs are the one place Rosetta goes online, and only at the reader's
  request (src/lib/opds.ts). A Calibre content server at home is usually plain
  http on a local address (http://192.168.1.20:8080/opds), which Android
  refuses by default and which can't be listed here ahead of time. Nothing
  else in the app makes requests, and the web view still blocks http inside
  the https page (allowMixedContent is false in capacitor.config.ts).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
